[Unit]
Description=Composite recording transport worker
After=network-online.target telegram-bot-api.service

[Service]
Type=simple
User=bigbluebutton
Group=bigbluebutton
EnvironmentFile=/etc/bbb-control-plane.env
ExecStart=/usr/bin/python3 /usr/local/lib/bcp-worker.py run
Restart=always
RestartSec=10
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/bcp /var/bigbluebutton

[Install]
WantedBy=multi-user.target
