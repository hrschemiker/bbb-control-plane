[Unit]
Description=Local Telegram Bot API
After=docker.service network-online.target
Requires=docker.service

[Service]
Restart=always
RestartSec=5
ExecStartPre=-/usr/bin/docker rm -f telegram-bot-api
ExecStart=/usr/bin/docker run --rm --name telegram-bot-api --network host -e TELEGRAM_API_ID=${TELEGRAM_API_ID} -e TELEGRAM_API_HASH=${TELEGRAM_API_HASH} -e TELEGRAM_LOCAL=1 -e TELEGRAM_HTTP_IP_ADDRESS=127.0.0.1 -e TELEGRAM_HTTP_PORT=8081 -e TELEGRAM_WORK_DIR=/var/lib/telegram-bot-api -e TELEGRAM_TEMP_DIR=/var/lib/telegram-bot-api -v /var/lib/telegram-bot-api:/var/lib/telegram-bot-api -v /var/bigbluebutton:/var/bigbluebutton:ro aiogram/telegram-bot-api:latest
ExecStop=/usr/bin/docker stop telegram-bot-api

[Install]
WantedBy=multi-user.target
