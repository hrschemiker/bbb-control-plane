[Unit]
Description=Local Telegram Bot API
After=docker.service network-online.target
Requires=docker.service

[Service]
Restart=always
RestartSec=5
ExecStartPre=-/usr/bin/docker rm -f telegram-bot-api
ExecStart=/usr/bin/docker run --rm --name telegram-bot-api --network host -v /var/lib/telegram-bot-api:/var/lib/telegram-bot-api aiogram/telegram-bot-api:latest --api-id=${TELEGRAM_API_ID} --api-hash=${TELEGRAM_API_HASH} --local --http-ip-address=127.0.0.1 --http-port=8081 --dir=/var/lib/telegram-bot-api
ExecStop=/usr/bin/docker stop telegram-bot-api

[Install]
WantedBy=multi-user.target
