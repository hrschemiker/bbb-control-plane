#!/usr/bin/env bash
set -Eeuo pipefail
case "${1:-}" in
  health)
    bbb-conf --check
    systemctl --no-pager --failed
    systemctl is-active bbb-rap-resque-worker bcp-worker telegram-bot-api
    df -h / /var/bigbluebutton
    ;;
  repair)
    bbb-conf --check
    systemctl restart bbb-rap-resque-worker telegram-bot-api
    if [ -f /var/lib/bcp/telegram-local.ready ]; then systemctl restart bcp-worker; fi
    bbb-conf --restart
    ;;
  restart) bbb-conf --restart ;;
  start) bbb-conf --start ;;
  stop) bbb-conf --stop ;;
  queue) find /var/lib/bcp/jobs -maxdepth 1 -type f -printf '%f\n' ;;
  logs)
    journalctl --no-pager -n 250 -u bcp-worker -u telegram-bot-api -u bbb-rap-resque-worker
    ;;
  telegram-migrate)
    set -a; . /etc/bbb-control-plane.env; set +a
    /usr/bin/env python3 /usr/local/lib/bcp-telegram-migrate.py
    systemctl enable --now bcp-worker
    ;;
  *) echo "usage: bcpctl {health|repair|restart|start|stop|queue|logs|telegram-migrate}" >&2; exit 2 ;;
esac
