#!/usr/bin/env bash
set -Eeuo pipefail
case "${1:-}" in
  health)
    bbb-conf --check
    systemctl --no-pager --failed
    systemctl is-active bbb-rap-resque-worker bcp-worker telegram-bot-api
    df -h / /var/bigbluebutton
    ;;
  repair)
    bbb-conf --check
    systemctl restart bbb-rap-resque-worker bcp-worker telegram-bot-api
    bbb-conf --restart
    ;;
  queue) find /var/lib/bcp/jobs -maxdepth 1 -type f -printf '%f\n' ;;
  *) echo "usage: bcpctl {health|repair|queue}" >&2; exit 2 ;;
esac
