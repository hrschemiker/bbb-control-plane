#!/usr/bin/env bash
set -Eeuo pipefail

repair_html5_config(){
  chmod 0755 /etc/bigbluebutton
  for config_file in \
    /etc/bigbluebutton/bbb-html5.yml \
    /etc/bigbluebutton/bbb-web.properties; do
    if [ -f "$config_file" ]; then
      chown root:root "$config_file"
      chmod 0644 "$config_file"
    fi
  done
}

verify_html5_auth(){
  local attempt
  for attempt in $(seq 1 12); do
    if curl -sS --max-time 3 http://127.0.0.1:8901/userInfo >/dev/null; then
      echo "bbb-html5 authentication endpoint: reachable"
      return 0
    fi
    sleep 5
  done
  systemctl --no-pager --full status 'bbb-html5-backend@*.service' bbb-apps-akka.service hasura-graphql-engine.service 2>/dev/null || true
  journalctl --no-pager -n 180 -u 'bbb-html5-backend@*.service' -u bbb-apps-akka.service -u hasura-graphql-engine.service || true
  echo "bbb-html5 authentication endpoint is unavailable" >&2
  return 1
}

repair_webrtc_sfu(){
  sfu_user=$(systemctl show -p User --value bbb-webrtc-sfu.service)
  [ -n "$sfu_user" ] || sfu_user=bigbluebutton
  sfu_group=$(id -gn "$sfu_user")
  chmod 0755 /etc/bigbluebutton
  if [ -d /etc/bigbluebutton/bbb-webrtc-sfu ]; then
    chgrp -R "$sfu_group" /etc/bigbluebutton/bbb-webrtc-sfu
    find /etc/bigbluebutton/bbb-webrtc-sfu -type d -exec chmod 0750 {} +
    find /etc/bigbluebutton/bbb-webrtc-sfu -type f -exec chmod 0640 {} +
  fi
  systemctl reset-failed bbb-webrtc-sfu.service
  systemctl restart bbb-webrtc-sfu.service || true
  sleep 8
  systemctl is-active --quiet bbb-webrtc-sfu.service && return 0
  if journalctl --no-pager -u bbb-webrtc-sfu.service -n 120 | grep -Eq '214/SETSCHEDULER|Failed at step SETSCHEDULER|Operation not permitted.*schedul'; then
    echo "Detected unsupported real-time scheduler for bbb-webrtc-sfu, applying the official systemd override"
    install -d -m 0755 /etc/systemd/system/bbb-webrtc-sfu.service.d
    printf '%s\n' '[Service]' 'CPUSchedulingPolicy=other' 'Nice=-10' > /etc/systemd/system/bbb-webrtc-sfu.service.d/override.conf
    systemctl daemon-reload
    systemctl restart bbb-webrtc-sfu.service
    sleep 8
  fi
  if ! systemctl is-active --quiet bbb-webrtc-sfu.service; then
    systemctl --no-pager --full status bbb-webrtc-sfu.service || true
    journalctl --no-pager -u bbb-webrtc-sfu.service -n 160 || true
    echo "bbb-webrtc-sfu is still unavailable" >&2
    return 1
  fi
}

repair_telegram_api(){
  systemctl reset-failed telegram-bot-api.service
  systemctl restart telegram-bot-api.service
  sleep 5
  if ! systemctl is-active --quiet telegram-bot-api.service; then
    systemctl --no-pager --full status telegram-bot-api.service || true
    journalctl --no-pager -u telegram-bot-api.service -n 120 || true
    echo "telegram-bot-api is unavailable" >&2
    return 1
  fi
}

guard_recording_worker(){
  if [ -f /var/lib/bcp/telegram-local.ready ]; then
    systemctl enable --now bcp-worker
  else
    systemctl disable --now bcp-worker 2>/dev/null || true
    echo "bcp-worker: safely disabled until Telegram migration is complete"
  fi
}

case "${1:-}" in
  health)
    echo "provision-state: $(cat /var/lib/bcp/provision/state 2>/dev/null || echo unknown)"
    systemctl --no-pager status bcp-provision.service 2>/dev/null || true
    bbb-conf --check
    systemctl --no-pager --failed
    systemctl is-active bbb-rap-resque-worker telegram-bot-api
    if [ -f /var/lib/bcp/telegram-local.ready ]; then systemctl is-active bcp-worker; else echo "inactive (expected: Telegram migration pending)"; fi
    df -h / /var/bigbluebutton
    ;;
  repair)
    bbb-conf --check
    systemctl restart bbb-rap-resque-worker
    repair_html5_config
    bbb-conf --restart
    verify_html5_auth
    repair_webrtc_sfu
    repair_telegram_api
    guard_recording_worker
    ;;
  restart) bbb-conf --restart ;;
  start) bbb-conf --start ;;
  stop) bbb-conf --stop ;;
  queue) find /var/lib/bcp/jobs -maxdepth 1 -type f -printf '%f\n' ;;
  logs)
    journalctl --no-pager -n 300 -u bcp-provision -u bcp-worker -u telegram-bot-api -u bbb-rap-resque-worker -u bbb-webrtc-sfu
    ;;
  provision-status)
    echo "state: $(cat /var/lib/bcp/provision/state 2>/dev/null || echo unknown)"
    systemctl --no-pager status bcp-provision.service 2>/dev/null || true
    tail -n 120 /var/log/bcp-provision.log 2>/dev/null || true
    dpkg --audit
    ;;
  telegram-migrate)
    set -a; . /etc/bbb-control-plane.env; set +a
    /usr/bin/env python3 /usr/local/lib/bcp-telegram-migrate.py
    systemctl enable --now bcp-worker
    ;;
  *) echo "usage: bcpctl {health|repair|restart|start|stop|queue|logs|provision-status|telegram-migrate}" >&2; exit 2 ;;
esac
